{
  "name": "oxido-repo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Repository tooling for Oxidō; the frontend is the web/ workspace",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "prepare": "lefthook install || echo ''",
    "dev": "bun run --cwd web dev",
    "dev:all": "bun scripts/dev.ts",
    "build": "bun run --cwd web build",
    "check": "tsc -p . && bun run --cwd web check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run && bun run --cwd web test",
    "test:e2e": "bun run --cwd web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@commitlint/lint": "^21",
    "@commitlint/load": "^21",
    "@types/node": "^26.6.2",
    "lefthook": "^2",
    "typescript": "^7",
    "vitest": "^5"
  }
}
