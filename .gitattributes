# Store text with LF and check it out with LF on every OS, whatever
# core.autocrlf says, so Windows checkouts don't show every file as changed.
* text=auto eol=lf

# Binary files: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.db binary
*.sqlite binary
